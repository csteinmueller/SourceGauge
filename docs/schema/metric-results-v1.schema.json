            { "type": "number", "minimum": -79228162514264337593543950335e-28, "maximum": 79228162514264337593543950335e-28, "multipleOf": 1e-28 }
          ]
        },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": ["kind", "projectId", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])(?:\\.\\./)*(?!\\.{1,2}(?:/|$))(?![\\s\\S]*?/\\.{1,2}(?:/|$))(?![A-Za-z]:)(?!/)(?![\\s\\S]*?\\\\)[^/]+(?:/[^/]+)*$"
        },
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])(?:\\.\\./)*(?!\\.{1,2}(?:/|$))(?![\\s\\S]*?/\\.{1,2}(?:/|$))(?![A-Za-z]:)(?!/)(?![\\s\\S]*?\\\\)[^/]+(?:/[^/]+)*$"
        }
