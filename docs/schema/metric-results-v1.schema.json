            { "type": "number", "minimum": -79228162514264337593543950335e-22, "maximum": 79228162514264337593543950335e-22, "multipleOf": 1e-22 },
            { "type": "number", "minimum": -79228162514264337593543950335e-23, "maximum": 79228162514264337593543950335e-23, "multipleOf": 1e-23 },
            { "type": "number", "minimum": -79228162514264337593543950335e-24, "maximum": 79228162514264337593543950335e-24, "multipleOf": 1e-24 },
