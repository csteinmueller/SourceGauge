#!/bin/sh
# Enforces Conventional Commits: <type>(optional scope)!: <subject>
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! echo "$first_line" | grep -qE '^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,100}$'; then
  echo "commit-msg: message must follow Conventional Commits, e.g. 'feat(metrics): add cyclomatic complexity'" >&2
  echo "commit-msg: got: $first_line" >&2
  exit 1
fi
